        var authorGuids = wishes.Select(w => w.AuthorGuid).Where(g => !string.IsNullOrEmpty(g)).Distinct().ToList();
        var names = await GetUserNamesAsync(authorGuids);

        foreach (var kv in names)
        {
            await db.Wishes
                .Where(w => w.AuthorGuid == kv.Key && (string.IsNullOrEmpty(w.AuthorName) || w.AuthorName != kv.Value))
                .ExecuteUpdateAsync(s => s.SetProperty(x => x.AuthorName, x => kv.Value));
        }

        return (wishes, hasMore);
    }

