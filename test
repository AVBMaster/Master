    public async Task<Dictionary<string, string>> GetUserNamesAsync(IEnumerable<string> guids)
    {
        await using var db = await _factory.CreateDbContextAsync();
        return await db.Users
                       .Where(u => guids.Contains(u.Uid.ToString()))
                       .ToDictionaryAsync(u => u.Uid!.ToString(), u => u.UserName!);
    }

    public async Task<Guid> AddUserAsync(Users user)
    {
        await using var db = await _factory.CreateDbContextAsync();
        user.Uid = Guid.NewGuid();
        db.Users.Add(user);
        await db.SaveChangesAsync();
        return user.Uid;
    }

    // 禁止注册/修改的用户名（可放到配置文件）
    private static readonly HashSet<string> ReservedNames =
        new(StringComparer.OrdinalIgnoreCase)
        {
        "null","该用户已注销","admin","root","system","undefined","匿名"
        };

    /// <summary>
    /// 是否为保留字
    /// </summary>
    public bool IsReservedUserName(string name)
        => string.IsNullOrWhiteSpace(name) || ReservedNames.Contains(name);

    /// <summary>
    /// 用户名是否可用（重名+保留字）
    /// </summary>
    /// <param name="name">待检查名称</param>
    /// <param name="excludeUid">修改时排除自己</param>
    public async Task<bool> IsUserNameAvailableAsync(string name, Guid? excludeUid = null)
    {
        if (IsReservedUserName(name)) return false;

        await using var db = await _factory.CreateDbContextAsync();
        return !await db.Users.AnyAsync(u => u.UserName == name &&
                                             (excludeUid == null || u.Uid != excludeUid));
    }

    public const string ID_SUPER = "super";
    public const string ID_ADMIN = "admin";

    /// <summary>
    /// 返回当前登录用户对目标用户可执行的操作权限
    /// </summary>
    public record UserPermission(
        bool CanViewDetail,
        bool CanEdit,
        bool CanLock,
        bool CanDelete
    );

    public UserPermission GetUserPermission(Users? current, Users target)
    {
        // 未登录
        if (current == null)
            return new(false, false, false, false);

        // super 拥有绝对权力
        if (current.Identity == ID_SUPER)
            return new(true, true, true, true);

        // admin 对 super 完全免疫
        if (current.Identity == ID_ADMIN && target.Identity == ID_SUPER)
            return new(false, false, false, false);

        // admin 对同级 admin：仅可查看/编辑，不可锁定/删除
        if (current.Identity == ID_ADMIN && target.Identity == ID_ADMIN)
            return new(true, true, false, false);

        // admin 对普通 user：全部可控
        if (current.Identity == ID_ADMIN)
            return new(true, true, true, true);

        // 普通用户对自己：仅可查看/编辑资料，不可改身份/锁定/删除
        if (current.Uid == target.Uid)
            return new(true, true, false, false);

        // 其余情况（普通用户看他人）仅可查看公开资料
        return new(true, false, false, false);
    }
