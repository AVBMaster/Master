    #region ====== Post ======
    //  1.如何区分子评论和顶级评论：给表添加一个RootPostUid字段，如果为null则为顶级评论，如果不为空则为顶级评论的Uid

    //  2.子评论回复的哪个评论（可能为子评论，可能为顶级评论）：给表添加一个ToPostUid字段,如果为null则为顶级评论,否则为目标评论Uid，这样一来就有层层递进的设计，能溯源

    public async Task<(List<PostDto> Data, bool HasMore)> GetPostsPageAsync(Guid plateUid, int page, int size)
    {
        await using var db = await _factory.CreateDbContextAsync();
        var plate = await db.Plates.FirstOrDefaultAsync(p => p.Uid == plateUid);
        if (plate == null) return (new(), false);

        // 获取顶级评论（RootPostUid为null的帖子）
        var (posts, hasMore) = await GetPageAsync(
            db.Posts.Where(p => p.PlateId == plate.Id && !p.IsDeleted && p.RootPostUid == null), page, size);

        var authorGuids = posts.Select(p => p.AuthorGuid?.ToString()).Where(g => g != null).Select(g => g!).ToList();
        var names = await GetUserNamesAsync(authorGuids);



        var dtos = posts.Select(p => new PostDto(
                                    p.Uid,
                                    p.RootPostUid ?? Guid.Empty,
                                    p.ToCommentUid ?? Guid.Empty,
                                    p.Title,
                                    p.Content,
                                    names.GetValueOrDefault(p.AuthorGuid.ToString()) ?? "该用户已注销",
                                    p.CreateTime,
                                    p.ReplyCount,
                                    p.LikeCount))
                         .ToList();
        return (dtos, hasMore);
    }

    public async Task<Post?> GetPostByGuidAsync(Guid uid)
    {
        await using var db = await _factory.CreateDbContextAsync();
        return await db.Posts.FirstOrDefaultAsync(p => p.Uid == uid);
    }

    public async Task<Guid> AddPostAsync(Post post, bool isReply = false, Guid? targetCommentUid = null)
    {
        await using var db = await _factory.CreateDbContextAsync();

        // 如果是回复，设置RootPostUid和ToCommentUid
        if (isReply)
        {
            if (targetCommentUid.HasValue)
            {
                var targetPost = await db.Posts.FindAsync(targetCommentUid.Value);
                if (targetPost != null)
                {
                    // 如果目标评论是顶级评论，RootPostUid设为顶级评论的Uid
                    // 如果目标评论是子评论，RootPostUid设为其RootPostUid
                    post.RootPostUid = targetPost.RootPostUid ?? targetPost.Uid;
                    post.ToCommentUid = targetPost.Uid;
                }
            }
        }

        db.Posts.Add(post);

        // 同步话题帖子数
        await db.Plates.Where(p => p.Id == post.PlateId)
                       .ExecuteUpdateAsync(p => p.SetProperty(x => x.PostCount, x => x.PostCount + 1));

        // 如果是回复，增加回复数
        if (isReply)
        {
            await db.Posts.Where(p => p.Uid == post.RootPostUid)
                           .ExecuteUpdateAsync(p => p.SetProperty(x => x.ReplyCount, x => x.ReplyCount + 1)
                                                     .SetProperty(x => x.LastReplyTime, x => DateTime.Now));
        }

        await db.SaveChangesAsync();
        return post.Uid;
    }
    #endregion

    #region ====== Confession / Wish ======
    public async Task<(List<Confession> Data, bool HasMore)> GetConfessionsPageAsync(int page, int size)
    {
        await using var db = await _factory.CreateDbContextAsync();
        var (confessions, hasMore) = await GetPageAsync(db.Confessions.Where(c => !c.IsDeleted), page, size);

        // 批量获取本页 AuthorGuid
        var authorGuids = confessions.Select(c => c.AuthorGuid).Where(g => !string.IsNullOrEmpty(g)).Distinct().ToList();
        var names = await GetUserNamesAsync(authorGuids);

        // 批量更新 AuthorName（只更新本页涉及的 AuthorGuid）
        foreach (var kv in names)
        {
            await db.Confessions
                .Where(c => c.AuthorGuid == kv.Key && (string.IsNullOrEmpty(c.AuthorName) || c.AuthorName != kv.Value))
                .ExecuteUpdateAsync(s => s.SetProperty(x => x.AuthorName, x => kv.Value));
        }

        return (confessions, hasMore);
    }

    public async Task AddConfessionAsync(Confession c)
    {
        await using var db = await _factory.CreateDbContextAsync();
        db.Confessions.Add(c);
        await db.SaveChangesAsync();
    }

