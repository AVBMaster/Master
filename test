    #region ====== 通用分页 ======
    private async Task<(List<T> Data, bool HasMore)> GetPageAsync<T>(
        IQueryable<T> query, int page, int size) where T : EntityBase
    {
        var data = await query.OrderByDescending(e => e.Id)
                              .Skip((page - 1) * size)
                              .Take(size + 1)
                              .ToListAsync();
        bool hasMore = data.Count > size;
        if (hasMore) data.RemoveAt(size);
        return (data, hasMore);
    }
    #endregion

    #region ====== 通用文件上传 ======
    private static readonly string[] _allowedImageExt = { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp" };
    private const int _maxImageSize = 2 * 1024 * 1024;          // 2 MB

    /// <summary>
    /// 通用图片上传（头像、封面、富文本插图...）
    /// 返回可直接访问的相对路径：/uploads/{subFolder}/xxx.ext
    /// </summary>
    /// <param name="file">IFormFile</param>
    /// <param name="subFolder">子目录名，如 avatar / cover / post</param>
    /// <param name="env">IWebHostEnvironment</param>
    public async Task<string> UploadImageAsync(IFormFile file,
                                               string subFolder,
                                               IWebHostEnvironment env)
    {
        if (file == null || file.Length == 0)
            throw new ArgumentException("未选择文件");

        var ext = Path.GetExtension(file.FileName).ToLowerInvariant();
        if (Array.IndexOf(_allowedImageExt, ext) < 0)
            throw new ArgumentException("不支持的图片格式");

        if (file.Length > _maxImageSize)
            throw new ArgumentException($"图片大小不能超过 {_maxImageSize / 1024 / 1024} MB");

        // 生成保存路径：wwwroot/uploads/{subFolder}/
        var saveDir = Path.Combine(env.WebRootPath, "uploads", subFolder);
        Directory.CreateDirectory(saveDir);

        var fileName = $"{Guid.NewGuid():N}{ext}";
        var filePath = Path.Combine(saveDir, fileName);

        await using var fs = File.Create(filePath);
        await file.CopyToAsync(fs);

        // 返回浏览器可直接访问的相对地址
        return $"/uploads/{subFolder}/{fileName}";
    }
    #endregion

    #region ====== Users ======
    public async Task<Users?> GetUserByGuidAsync(string guid)
    {
        await using var db = await _factory.CreateDbContextAsync();
        return await db.Users.FirstOrDefaultAsync(u => u.Uid.ToString() == guid);
