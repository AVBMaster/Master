    #region ====== Plate ======
    public async Task<(List<PlateDto> Data, bool HasMore)> GetPlatesPageAsync(int page, int size)
    {
        await using var db = await _factory.CreateDbContextAsync();
        var (plates, hasMore) = await GetPageAsync(db.Plates.Where(p => !p.IsDeleted), page, size);

        var authorGuids = plates.Select(p => p.CreatorGuid.ToString()).Where(g => g != null).Select(g => g!).ToList();
        var names = await GetUserNamesAsync(authorGuids);


        var dtos = plates.Select(p => new PlateDto(
                                    p.Uid,
                                    p.Name,
                                    p.Introduction,
                                    p.CreatorGuid,
                                    names.GetValueOrDefault(p.CreatorGuid.ToString()) ?? "该用户已注销",
                                    p.CreateTime,
                                    p.PostCount,
                                    p.ViewCount,
                                    p.LikeCount))
                         .ToList();
        return (dtos, hasMore);
    }

    public async Task<Guid> AddPlateAsync(Plate plate)
    {
        await using var db = await _factory.CreateDbContextAsync();
        // 修正 CreatorGuid 为空的情况
        if (plate.CreatorGuid == Guid.Empty && plate.Uid != Guid.Empty)
        {
            // 尝试用 Uid 赋值（如果逻辑有误可改为传入的用户 Guid）
            // plate.CreatorGuid = plate.Uid;
            throw new Exception("CreatorGuid 不能为空，请传入有效的用户 Guid");
        }
        db.Plates.Add(plate);
        await db.SaveChangesAsync();
        return plate.Uid;
    }

